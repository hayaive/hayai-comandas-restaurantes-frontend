# Base URL of the Hayai Comandas backend (NestJS), e.g. https://api.hayai.example
# Leave unset / commented out during development: the app falls back to the
# in-memory mock client (src/api/mockClient.ts) so every screen works with
# coherent fixture data before the backend is deployed. Once the backend is
# reachable, set this and the app switches to real HTTP calls automatically —
# no component changes required.
# VITE_API_URL=http://localhost:3000/api/v1
