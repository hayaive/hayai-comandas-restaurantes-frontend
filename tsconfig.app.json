{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  // `src/sw.ts` compila aparte (ver tsconfig.sw.json): necesita la lib
  // "webworker" para `self`/`ServiceWorkerGlobalScope`, y esa lib es
  // incompatible con "dom" en el mismo programa TS (ambas declaran `self`
  // con tipos distintos — TS no deja mezclarlas).
  "exclude": ["src/sw.ts"]
}
